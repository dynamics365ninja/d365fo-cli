<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>D365FO.Core</RootNamespace>
    <AssemblyName>D365FO.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>D365FO.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Index\Schema.sql" />
    <!-- MetaModel serialization contracts (namespace + member order per type), generated by
         scripts/emit-metadata-contracts.ps1 from Microsoft.Dynamics.AX.Metadata.dll. Embedded
         so the order checks work on any machine, including CI, which has no D365FO install. -->
    <EmbeddedResource Include="Metadata\metadata-contracts.json" />
    <!-- Copy of the upstream MCP server's eval/compiler-facts.snapshot.json: the shipped
         compiler's own keywords, intrinsics and run-time function arities. Consumed by
         Validation\CompilerFacts.cs (FN001/FN002/KW001/ATTR001 and friends). -->
    <EmbeddedResource Include="Validation\compiler-facts.json" />
    <!-- The AOT form-pattern registry (name + version + required parts and property
         values per pattern), generated by scripts/emit-form-patterns.ps1 from
         Microsoft.Dynamics.AX.Metadata.Patterns.dll. The AOS validates every form
         against this and rejects a pattern name or version it does not have, so it is
         embedded to make that checkable without an installation. -->
    <EmbeddedResource Include="FormPatterns\form-patterns.json" />
    <EmbeddedResource Include="Scaffolding\FormTemplates\*.template.xml" />
    <!-- Knowledge topics served by `d365fo knowledge` / the MCP `get_knowledge`
         tool. Embedded straight from the single-source skill corpus so a fact is
         corrected in exactly one place (see D365FO.Core/Knowledge/KnowledgeBase.cs). -->
    <EmbeddedResource Include="..\..\skills\_source\*.md">
      <LogicalName>D365FO.Core.Knowledge.%(Filename).md</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
