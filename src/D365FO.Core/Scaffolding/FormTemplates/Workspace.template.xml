<?xml version="1.0" encoding="utf-8"?>
<AxForm xmlns:i="http://www.w3.org/2001/XMLSchema-instance" xmlns="Microsoft.Dynamics.AX.Metadata.V6">
  <Name>{FormName}</Name>
  <SourceCode>
    <Methods xmlns="">
      <Method>
        <Name>classDeclaration</Name>
        <Source><![CDATA[
[Form]
public class {FormName} extends FormRun
{
}

]]></Source>
      </Method>
    </Methods>
    <DataSources xmlns="" />
    <DataControls xmlns="" />
    <Members xmlns="" />
  </SourceCode>
  <DataSources>
    <AxFormDataSource xmlns="">
      <Name>{DsName}</Name>
      <Table>{DsTable}</Table>
      <Fields />
      <ReferencedDataSources />
      <AllowCreate>No</AllowCreate>
      <AllowEdit>No</AllowEdit>
      <AllowDelete>No</AllowDelete>
      <InsertIfEmpty>No</InsertIfEmpty>
      <DataSourceLinks />
      <DerivedDataSources />
    </AxFormDataSource>
  </DataSources>
  <Design>
    <ArrangeMethod xmlns="">Vertical</ArrangeMethod>
{Caption}    <Columns xmlns="">1</Columns>
    <ColumnsMode xmlns="">Fixed</ColumnsMode>
    <!--
      "Workspace" exists in the AOT registry only as an inactive 2.0; the active
      pattern for an operational workspace is WorkspaceOperational 1.1, whose sections
      live on a FastTabs tab rather than a Panorama.
    -->
    <Pattern xmlns="">WorkspaceOperational</Pattern>
    <PatternVersion xmlns="">1.1</PatternVersion>
    <ShowDeleteButton xmlns="">No</ShowDeleteButton>
    <ShowNewButton xmlns="">No</ShowNewButton>
    <Style xmlns="">Workspace</Style>
    <ViewEditMode xmlns="">View</ViewEditMode>
    <Controls xmlns="">
      <AxFormControl xmlns="" i:type="AxFormActionPaneControl">
        <Name>ActionPane</Name>
        <ElementPosition>134217727</ElementPosition>
        <FilterExpression>%1</FilterExpression>
        <Type>ActionPane</Type>
        <VerticalSpacing>-1</VerticalSpacing>
        <FormControlExtension i:nil="true" />
        <Controls>
          <AxFormControl xmlns="" i:type="AxFormActionPaneTabControl">
            <Name>ActionPaneTab</Name>
            <Type>ActionPaneTab</Type>
            <FormControlExtension i:nil="true" />
            <Controls>
              <AxFormControl xmlns="" i:type="AxFormButtonGroupControl">
                <Name>NewButtonGroup</Name>
                <Type>ButtonGroup</Type>
                <FormControlExtension i:nil="true" />
                <Controls />
              </AxFormControl>
            </Controls>
          </AxFormControl>
        </Controls>
        <AlignChild>No</AlignChild>
        <AlignChildren>No</AlignChildren>
        <ArrangeMethod>Vertical</ArrangeMethod>
      </AxFormControl>
      <!--
        WorkspaceOperational's sections are FastTab pages, each declaring the
        sub-pattern that says what kind of section it is. Summary tiles, a tabbed
        list and related links are required; charts and Power BI are optional.
        The previous shape was a Panorama tab whose Summary page nested a ChartSection
        group — "has child 'ChartSection' which is not allowed at its current location".
      -->
      <AxFormControl xmlns="" i:type="AxFormTabControl">
        <Name>WorkspaceSections</Name>
        <ElementPosition>268435455</ElementPosition>
        <Enabled>Yes</Enabled>
        <ExtendedStyle>tab_simpleFastTab</ExtendedStyle>
        <Height>-1</Height>
        <HeightMode>SizeToAvailable</HeightMode>
        <Type>Tab</Type>
        <Width>-1</Width>
        <WidthMode>SizeToAvailable</WidthMode>
        <FormControlExtension i:nil="true" />
        <Controls>
          <AxFormControl xmlns="" i:type="AxFormTabPageControl">
            <!-- 1.1, not 1.0: the section sub-patterns' 1.0 versions are inactive. -->
            <Name>SectionSummaryTiles</Name>
            <Caption>Summary</Caption>
            <ElementPosition>536870911</ElementPosition>
            <ExtendedStyle>workspace_tileLayout</ExtendedStyle>
            <Pattern>SectionTiles</Pattern>
            <PatternVersion>1.1</PatternVersion>
            <Type>TabPage</Type>
            <FormControlExtension i:nil="true" />
            <!-- Add AxFormControl i:type="AxFormButtonControl" tiles here -->
            <Controls />
            <ArrangeMethod>HorizontalLeft</ArrangeMethod>
            <ColumnsMode>Fixed</ColumnsMode>
            <FastTabExpanded>Yes</FastTabExpanded>
          </AxFormControl>
          <AxFormControl xmlns="" i:type="AxFormTabPageControl">
            <Name>SectionTabbedList</Name>
            <Caption>Lists</Caption>
            <Pattern>SectionTabbedList</Pattern>
            <PatternVersion>1.1</PatternVersion>
            <Type>TabPage</Type>
            <FormControlExtension i:nil="true" />
            <Controls>
              <!--
                The sub-pattern's 'Tabbed List' part: the section holds a vertical tab,
                and the lists are its pages. A tab page cannot contain a tab page
                directly, which is what the flat shape tried.
              -->
              <AxFormControl xmlns="" i:type="AxFormTabControl">
                <Name>TabbedList</Name>
                <Height>500</Height>
                <HeightMode>Manual</HeightMode>
                <Skip>No</Skip>
                <Type>Tab</Type>
                <Visible>Yes</Visible>
                <Width>-1</Width>
                <WidthMode>SizeToAvailable</WidthMode>
                <FormControlExtension i:nil="true" />
                <Controls>
{ListSections}                </Controls>
                <AllowUserSetup>Yes</AllowUserSetup>
                <ArrangeMethod>Vertical</ArrangeMethod>
                <Columns>1</Columns>
                <ColumnsMode>Fixed</ColumnsMode>
                <ShowTabs>Yes</ShowTabs>
                <Style>VerticalTabs</Style>
              </AxFormControl>
            </Controls>
            <FastTabExpanded>Yes</FastTabExpanded>
          </AxFormControl>
          <AxFormControl xmlns="" i:type="AxFormTabPageControl">
            <Name>SectionRelatedLinks</Name>
            <Caption>Related links</Caption>
            <Pattern>SectionRelatedLinks</Pattern>
            <PatternVersion>1.1</PatternVersion>
            <Type>TabPage</Type>
            <FormControlExtension i:nil="true" />
            <!-- Add AxFormControl i:type="AxFormMenuButtonControl" links here -->
            <Controls />
            <ColumnsMode>Fill</ColumnsMode>
            <FastTabExpanded>Yes</FastTabExpanded>
          </AxFormControl>
        </Controls>
        <ShowTabs>Yes</ShowTabs>
        <Style>FastTabs</Style>
      </AxFormControl>
    </Controls>
  </Design>
  <Parts />
</AxForm>
