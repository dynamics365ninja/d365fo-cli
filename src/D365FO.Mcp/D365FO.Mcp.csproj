<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>d365fo-mcp</AssemblyName>
    <RootNamespace>D365FO.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\D365FO.Core\D365FO.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Console SDK project (not Sdk.Web) that also hosts a minimal ASP.NET Core
      app for the HTTP transport (see HttpServerHost.cs, "d365fo mcp http"
      flag). FrameworkReference pulls in WebApplication, Kestrel, routing,
      Microsoft.AspNetCore.RateLimiting, and Microsoft.Extensions.Logging
      (superseding the standalone Logging package this project used before)
      without switching to Sdk.Web, which changes default static asset and
      publish behavior we don't want for a CLI style executable.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
